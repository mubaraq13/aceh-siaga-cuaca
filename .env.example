# ============================================================================
# ACEH SIAGA CUACA — ENVIRONMENT CONFIGURATION
# ============================================================================

APP_NAME="ACEH SIAGA CUACA"
APP_ENV="development"
APP_TIMEZONE="Asia/Jakarta"
DEMO_MODE=false

# Database PostgreSQL + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aceh_siaga_cuaca
POSTGRES_USER=aceh_weather_user
POSTGRES_PASSWORD=change_this_strong_password_in_prod
DATABASE_URL=postgresql+psycopg2://aceh_weather_user:change_this_strong_password_in_prod@localhost:5432/aceh_siaga_cuaca

# BMKG Official Endpoints
BMKG_FORECAST_API_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca
BMKG_NOWCAST_RSS_URL=https://www.bmkg.go.id/alerts/nowcast/id
BMKG_USER_AGENT="AcehSiagaCuaca-ResearchPlatform/1.0 (+https://acehprov.go.id; research-hydromet@aceh)"

# Rate Limiting & Caching (Batas BMKG: 60 req/menit/IP -> Kita batasi 45 req/menit)
BMKG_RATE_LIMIT_REQUESTS_PER_MINUTE=45
BMKG_REQUEST_TIMEOUT_SECONDS=15
BMKG_MAX_RETRIES=3
BMKG_CACHE_TTL_SECONDS=10800
BMKG_CACHE_DIR=data/raw/bmkg/cache

# Backend & Frontend URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1